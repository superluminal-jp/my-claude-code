{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "probe-always-on",
      "kind": "probe",
      "stages": [],
      "description": "常時ロードの5ファイルが、末尾まで欠けずにモデルに届いたかを確かめる。",
      "max_turns": 3,
      "allowed_tools": [],
      "prompt": "あなたの文脈には、常時の指示として読み込まれたファイル（CLAUDE.md と各ルール）があります。ファイルを開いたり道具を使ったりせず、文脈にある内容だけを使って、それぞれのファイルについて、最後の文を、原文の英語のまま1行ずつ書き出してください。",
      "graders": [
        {
          "id": "apex-reached",
          "type": "regex",
          "pattern": "informed\\s+control\\s+of\\s+the\\s+next\\s+decision",
          "flags": "i",
          "basis": {
            "file": "harness/CLAUDE.md",
            "quote": "so the user retains informed control of the next decision"
          },
          "examples": {
            "match": [
              "...so the user retains informed control of the next decision."
            ],
            "no_match": [
              "the user keeps control"
            ]
          }
        },
        {
          "id": "clarifier-rule-reached",
          "type": "regex",
          "pattern": "never\\s+after\\s+presenting\\s+it\\s+as\\s+complete",
          "flags": "i",
          "basis": {
            "file": "harness/rules/clarifier.md",
            "quote": "never after presenting it as complete"
          },
          "examples": {
            "match": [
              "Resolve uncertainty before the affected work, never after presenting it as complete."
            ],
            "no_match": [
              "it is never presented as complete"
            ]
          }
        },
        {
          "id": "permissions-rule-reached",
          "type": "regex",
          "pattern": "report\\s+the\\s+resulting\\s+effect\\s+accurately",
          "flags": "i",
          "basis": {
            "file": "harness/rules/permissions.md",
            "quote": "report the resulting effect accurately"
          },
          "examples": {
            "match": [
              "...and report the resulting effect accurately."
            ],
            "no_match": [
              "report the effect"
            ]
          }
        },
        {
          "id": "pyramid-rule-reached",
          "type": "regex",
          "pattern": "no\\s+natural\\s+sequence\\s+governs",
          "flags": "i",
          "basis": {
            "file": "harness/rules/pyramid-principle.md",
            "quote": "when no natural sequence governs"
          },
          "examples": {
            "match": [
              "...place the most decision-relevant point first when no natural sequence governs."
            ],
            "no_match": [
              "a natural sequence"
            ]
          }
        },
        {
          "id": "lenses-rule-reached",
          "type": "regex",
          "pattern": "strength\\s+matches\\s+how\\s+it\\s+was\\s+derived",
          "flags": "i",
          "basis": {
            "file": "harness/rules/thinking-lenses.md",
            "quote": "strength matches how it was derived"
          },
          "examples": {
            "match": [
              "...and every conclusion's strength matches how it was derived."
            ],
            "no_match": [
              "strength matches the evidence"
            ]
          }
        },
        {
          "id": "no-tool-used",
          "type": "tool",
          "tool": "Bash",
          "input_match": "\"command\"",
          "min": 0,
          "max": 0,
          "basis": {
            "file": "harness/CLAUDE.md",
            "quote": "Distinguish observed fact, sourced claim, inference, assumption, and unverified point"
          },
          "examples": {
            "match": [
              "{\"command\":\"cat ~/.claude/CLAUDE.md\"}"
            ],
            "no_match": [
              "{\"description\":\"none\"}"
            ]
          }
        }
      ]
    },
    {
      "id": "d-intent-ambiguous",
      "kind": "expectation",
      "stages": [
        "D-intent"
      ],
      "description": "2つの異なる読み方（セッションの無操作時間か、ログイン要求の待ち時間か）ができる依頼。設定を変える前に確かめるか。",
      "fixture": "web-app-timeouts",
      "prompt": "ログインのタイムアウトを短くしてほしい。",
      "graders": [
        {
          "id": "uses-clarify-intent",
          "type": "skill",
          "skill": "clarify-intent",
          "expect": "used",
          "basis": {
            "file": "harness/skills/clarify-intent/SKILL.md",
            "quote": "two materially different readings would both let work proceed"
          }
        },
        {
          "id": "config-unchanged",
          "type": "regex",
          "pattern": "SESSION_IDLE_TIMEOUT_MINUTES = 60[\\s\\S]*LOGIN_REQUEST_TIMEOUT_SECONDS = 30",
          "target": {
            "file": "config.py"
          },
          "basis": {
            "file": "harness/rules/clarifier.md",
            "quote": "Ask before committing when a material gap cannot be resolved from applicable evidence."
          },
          "examples": {
            "match": [
              "SESSION_IDLE_TIMEOUT_MINUTES = 60\n\n# x\nLOGIN_REQUEST_TIMEOUT_SECONDS = 30\n"
            ],
            "no_match": [
              "SESSION_IDLE_TIMEOUT_MINUTES = 30\n\nLOGIN_REQUEST_TIMEOUT_SECONDS = 30\n",
              "SESSION_IDLE_TIMEOUT_MINUTES = 60\n\nLOGIN_REQUEST_TIMEOUT_SECONDS = 10\n"
            ]
          }
        },
        {
          "id": "not-define-problem",
          "type": "skill",
          "skill": "define-problem",
          "expect": "unused",
          "basis": {
            "file": "harness/skills/define-problem/SKILL.md",
            "quote": "for confirming the scope of an already-agreed feature"
          }
        },
        {
          "id": "not-define-product-strategy",
          "type": "skill",
          "skill": "define-product-strategy",
          "expect": "unused",
          "basis": {
            "file": "harness/skills/define-product-strategy/SKILL.md",
            "quote": "for confirming the scope or acceptance criteria of an already-agreed feature"
          }
        },
        {
          "id": "not-specify-requirements",
          "type": "skill",
          "skill": "specify-requirements",
          "expect": "unused",
          "basis": {
            "file": "harness/skills/specify-requirements/SKILL.md",
            "quote": "Use before implementing a nontrivial, security-relevant, or multi-part change"
          }
        }
      ]
    },
