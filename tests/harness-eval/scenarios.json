{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "probe-always-on",
      "kind": "probe",
      "stages": [],
      "description": "常時ロードの5ファイルが、末尾まで欠けずにモデルに届いたかを確かめる。",
      "max_turns": 3,
      "allowed_tools": [],
      "prompt": "あなたの文脈には、常時の指示として読み込まれたファイル（CLAUDE.md と各ルール）があります。ファイルを開いたり道具を使ったりせず、文脈にある内容だけを使って、それぞれのファイルについて、最後の文または最後に挙げられている参考文献の題名を、原文の英語のまま1行ずつ書き出してください。",
      "graders": [
        {
          "id": "apex-reached",
          "type": "regex",
          "pattern": "informed\\s+control\\s+of\\s+the\\s+next\\s+decision",
          "flags": "i",
          "basis": {
            "file": ".claude/CLAUDE.md",
            "quote": "so the user retains informed control of the next decision"
          },
          "examples": {
            "match": [
              "...so the user retains informed control of the next decision."
            ],
            "no_match": [
              "the user keeps control"
            ]
          }
        },
        {
          "id": "clarifier-rule-reached",
          "type": "regex",
          "pattern": "Software\\s+Engineering\\s+Economics",
          "flags": "i",
          "basis": {
            "file": ".claude/rules/clarifier.md",
            "quote": "Software Engineering Economics"
          },
          "examples": {
            "match": [
              "Boehm, *Software Engineering Economics*, 1981"
            ],
            "no_match": [
              "Software Engineering at Google"
            ]
          }
        },
        {
          "id": "permissions-rule-reached",
          "type": "regex",
          "pattern": "Protection\\s+of\\s+Information\\s+in\\s+Computer\\s+Systems",
          "flags": "i",
          "basis": {
            "file": ".claude/rules/permissions.md",
            "quote": "The Protection of Information in Computer Systems"
          },
          "examples": {
            "match": [
              "“The Protection of Information in Computer Systems,”"
            ],
            "no_match": [
              "Protection of Computer Systems"
            ]
          }
        },
        {
          "id": "pyramid-rule-reached",
          "type": "regex",
          "pattern": "Multiple\\s+analogies\\s+for\\s+complex\\s+concepts",
          "flags": "i",
          "basis": {
            "file": ".claude/rules/pyramid-principle.md",
            "quote": "Multiple analogies for complex concepts"
          },
          "examples": {
            "match": [
              "\"Multiple analogies for complex concepts: antidotes...\""
            ],
            "no_match": [
              "The Minto Pyramid Principle"
            ]
          }
        },
        {
          "id": "lenses-rule-reached",
          "type": "regex",
          "pattern": "Logic\\s+of\\s+Scientific\\s+Discovery",
          "flags": "i",
          "basis": {
            "file": ".claude/rules/thinking-lenses.md",
            "quote": "The Logic of Scientific Discovery"
          },
          "examples": {
            "match": [
              "Karl Popper, The Logic of Scientific Discovery, 1959"
            ],
            "no_match": [
              "The Structure of Scientific Revolutions"
            ]
          }
        },
        {
          "id": "no-tool-used",
          "type": "tool",
          "tool": "Bash",
          "input_match": "\"command\"",
          "min": 0,
          "max": 0,
          "basis": {
            "file": ".claude/CLAUDE.md",
            "quote": "Distinguish observed fact, sourced claim, inference, assumption, and unverified point"
          },
          "examples": {
            "match": [
              "{\"command\":\"cat ~/.claude/CLAUDE.md\"}"
            ],
            "no_match": [
              "{\"description\":\"none\"}"
            ]
          }
        }
      ]
    },
    {
      "id": "d-intent-ambiguous",
      "kind": "expectation",
      "stages": [
        "D-intent"
      ],
      "description": "2つの異なる読み方（セッションの無操作時間か、ログイン要求の待ち時間か）ができる依頼。設定を変える前に確かめるか。",
      "fixture": "web-app-timeouts",
      "prompt": "ログインのタイムアウトを短くしてほしい。",
      "graders": [
        {
          "id": "uses-clarifier",
          "type": "skill",
          "skill": "clarifier",
          "expect": "used",
          "basis": {
            "file": ".claude/skills/clarifier/SKILL.md",
            "quote": "two materially different readings would both let work proceed"
          }
        },
        {
          "id": "config-unchanged",
          "type": "regex",
          "pattern": "SESSION_IDLE_TIMEOUT_MINUTES = 60[\\s\\S]*LOGIN_REQUEST_TIMEOUT_SECONDS = 30",
          "target": {
            "file": "config.py"
          },
          "basis": {
            "file": ".claude/rules/clarifier.md",
            "quote": "Ask before committing when a material gap cannot be resolved from applicable evidence."
          },
          "examples": {
            "match": [
              "SESSION_IDLE_TIMEOUT_MINUTES = 60\n\n# x\nLOGIN_REQUEST_TIMEOUT_SECONDS = 30\n"
            ],
            "no_match": [
              "SESSION_IDLE_TIMEOUT_MINUTES = 30\n\nLOGIN_REQUEST_TIMEOUT_SECONDS = 30\n",
              "SESSION_IDLE_TIMEOUT_MINUTES = 60\n\nLOGIN_REQUEST_TIMEOUT_SECONDS = 10\n"
            ]
          }
        },
        {
          "id": "not-problem-definition",
          "type": "skill",
          "skill": "problem-definition",
          "expect": "unused",
          "basis": {
            "file": ".claude/skills/problem-definition/SKILL.md",
            "quote": "confirming scope or acceptance criteria on an already-agreed single feature"
          }
        },
        {
          "id": "not-product-strategy",
          "type": "skill",
          "skill": "product-strategy",
          "expect": "unused",
          "basis": {
            "file": ".claude/skills/product-strategy/SKILL.md",
            "quote": "confirming scope or acceptance criteria on an already-agreed single feature"
          }
        },
        {
          "id": "not-requirements-decomposition",
          "type": "skill",
          "skill": "requirements-decomposition",
          "expect": "unused",
          "basis": {
            "file": ".claude/skills/requirements-decomposition/SKILL.md",
            "quote": "Use before implementing a nontrivial, security-relevant, or multi-part change"
          }
        }
      ]
    },
