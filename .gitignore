.DS_Store
__pycache__/
*.py[cod]

# Local to each checkout, never committed: this repository's own Claude Code
# project settings, and the per-project workflow tools (Spec Kit, AI-DLC) with
# the files they generate.
.claude/
.mcp.json
.specify/
specs/
aidlc-docs/
tests/harness-eval/

# A macOS global ignore file commonly carries an `Icon` rule, and Git on macOS
# matches ignore patterns case-insensitively, so that rule would swallow this
# directory of the bundled DADS documentation.
!harness/skills/apply-dads-frontend/references/dads-docs/foundations/icon/
