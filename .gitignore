# spec-kit skills are per-project artifacts (regenerated by `specify init`),
# not part of this repo's shared/vendored config, for any agent integration
# `specify init --integration <agent>` targets — see
# docs/adr/0001-remove-vendored-speckit-skills.md
.claude/skills/speckit-*/
.agents/skills/speckit-*/
.cursor/skills/speckit-*/

